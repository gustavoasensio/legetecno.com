# ── PPI Producción ────────────────────────────────────────────────────────────
# Key pública: visible en tu cuenta PPI → Configuración → API
# Key privada: si la perdiste, escribí a api@portfoliopersonal.com
# NUNCA compartas estas claves. Guardalas solo en este archivo .env (nunca lo subas a git).
PPI_PUBLIC_KEY=tu_key_publica_produccion
PPI_PRIVATE_KEY=tu_key_privada_produccion

# ── PPI Sandbox (para probar sin dinero real) ──────────────────────────────────
# Activar sandbox: cambiar a true mientras probás
PPI_SANDBOX=false
PPI_SANDBOX_PUBLIC_KEY=a0RtQVZHSzFLdFdpTEhRSWVHNzU=
PPI_SANDBOX_PRIVATE_KEY=YTU0NWRlMTEtN2E3YS00NTljLWEwMWYtZTcwODU3NWU2MjY2

