# ── PPI (Portfolio Personal Inversiones) ──────────────────────────────────────
# Key pública: visible en tu cuenta PPI → Configuración → API
PPI_PUBLIC_KEY=tu_key_publica_aqui

# Key privada: si la perdiste, escribí a api@portfoliopersonal.com
# NUNCA compartas esta clave. Guardala solo en este archivo.
PPI_PRIVATE_KEY=tu_key_privada_aqui

# ── Anthropic API (OPCIONAL) ───────────────────────────────────────────────────
# Solo necesaria si querés correr el orchestrator sin Claude Code.
# Con tu plan de $20/mes en claude.ai ya tenés análisis completo acá.
# ANTHROPIC_API_KEY=sk-ant-...

# ── InvertirOnline (alternativa a PPI para datos de BYMA) ─────────────────────
# IOL_USER=tu_usuario_iol
# IOL_PASSWORD=tu_password_iol
